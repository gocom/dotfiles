#!/usr/bin/env bash

_gpg-helper () {
  local cur prev words cword

  _init_completion || return

  case "$cur" in
    -*)
      COMPREPLY=($(compgen -W '$( _parse_help "$1" )' -- "$cur"))
      return
      ;;
  esac

  if [ "$cword" -eq 1 ]; then
    COMPREPLY=($(compgen -W 'edit export import keygrip list public reload signature trust' -- "$cur"))
  fi
} && complete -F _gpg-helper gpg-helper
